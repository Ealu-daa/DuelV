  skillName: "\u30B0\u30ED\u30A6\u30B7\u30A7\u30EB"
  skillDescription: "\u81EA\u5206\u306B\u6700\u5927HP+1\u3001HP1\u56DE\u5FA9(\u91CD\u306D\u304C\u3051\u53EF\u80FD\u3001\u4E0A\u9650\u306A\u3057)\u3002\u5473\u65B9FW(\u3082\u3046\u4E00\u65B9)\u306B\u653B\u6483\u529B+1(\u91CD\u306D\u304C\u3051\u53EF\u80FD\u3001\u4E0A\u9650+2)\u3002\u52B9\u679C\u306F\u4EA4\u4EE3\u30FB\u6226\u95D8\u4E0D\u80FD\u3067\u3082\u6D88\u3048\u306A\u3044"
  ultName: "\u30E1\u30BF\u30E2\u30EB\u30D5\u30A9\u30B7\u30B9"
  ultDescription: "\u6226\u95D8\u4E0D\u80FD\u306B\u306A\u3063\u305F\u6642\u3001\u901A\u5E38\u306E\u7E70\u308A\u4E0A\u304C\u308A\u306E\u4EE3\u308F\u308A\u306B\u300C\u4EEE\u6B7B\u72B6\u614B\u300D\u306B\u306A\u308B(\u7E70\u308A\u4E0A\u304C\u308A\u306A\u3057\u3001\u30A6\u30EB\u30C8\u3092\u4F7F\u3046\u304B\u4EA4\u4EE3\u3059\u308B\u307E\u3067\u884C\u52D5\u4E0D\u53EF)\u3002\u4EEE\u6B7B\u72B6\u614B\u306EHP\u306F18\u56FA\u5B9A\u3002\u4EEE\u6B7B\u4E2D\u3082\u30C0\u30E1\u30FC\u30B8\u3092\u53D7\u3051\u308B\u3068ULT\u30B2\u30FC\u30B8\u306F\u901A\u5E38\u901A\u308A\u8CAF\u307E\u308B\u3002\u4EEE\u6B7B\u4E2D\u306B\u4EA4\u4EE3\u3059\u308B\u3068\u3001\u305D\u306E\u307E\u307E\u6226\u95D8\u4E0D\u80FD\u6271\u3044\u306B\u306A\u308B\u3002\u4EEE\u6B7B\u4E2D\u306B\u30A6\u30EB\u30C8\u3092\u4F7F\u3046\u3068\u3001\u88AB\u5F3E\u5206\u3092\u5F15\u3044\u305F\u6B8B\u308AHP\u3067\u5FA9\u6D3B\u3057\u3001\u30B9\u30AD\u30EB\u3067\u7A4D\u307F\u4E0A\u3052\u305F\u6700\u5927HP\u5897\u52A0\u5206\u306E\u5408\u8A08\u3092\u653B\u6483\u529B\u306B\u52A0\u7B97\u3059\u308B(\u3053\u306E\u6642\u3001\u6700\u5927HP\u306F18\u306B\u623B\u308B)"
